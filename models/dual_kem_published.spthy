/*
  ============================================================================
  Dual-KEM, AS PUBLISHED  (Hulsing, Lange, Weber, CANS 2025, Sec. 2.1)
  ============================================================================

  The paper defines Dual-KEM as Triple-KEM without the ciphertext to the
  responder's long-term key and without the responder's optional updated
  long-term key. On the literal Fig. 1 reading, M2 therefore carries only the
  two ciphertexts, with no SAT -> MC confirmation.

    M1  MC -> SAT :  AEAD_psk( pk_e )
    M2  SAT-> MC  :  AEAD_psk( c_e , c_mc )
    M3  MC -> SAT :  confirm_mc

  Identical to models/dual_kem.spthy except for M2. FA-02's two falsifications
  can only get easier without the confirmation; the two lemmas that verify in
  dual_kem.spthy are re-checked here rather than assumed.
  ============================================================================
*/

theory dual_kem_published
begin

builtins: asymmetric-encryption, symmetric-encryption, hashing

functions: kdf/1

rule Register_ltk:
    [ Fr(~ltk) ]
  --[ OnlyOnce($A) ]->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Register_psk:
    [ Fr(~psk) ]
  --[ PskInit($MC, $SAT) ]->
    [ !Psk($MC, $SAT, ~psk) ]

rule Reveal_ltk:
    [ !Ltk($A, ltk) ] --[ LtkReveal($A) ]-> [ Out(ltk) ]

rule Reveal_psk:
    [ !Psk($MC, $SAT, psk) ] --[ PskReveal($MC, $SAT) ]-> [ Out(psk) ]

rule MC_1:
    let pke = pk(~ske)
        m1  = senc(<'pl1', pke>, psk)
    in
    [ !Ltk($MC, ltkMC)
    , !Pk($SAT, pkSAT)
    , !Psk($MC, $SAT, psk)
    , Fr(~ske)
    , Fr(~sid) ]
  --[ StartMC($MC, $SAT, ~sid) ]->
    [ St_MC_1($MC, $SAT, ~sid, ltkMC, psk, ~ske, pke)
    , Out(<'M1', m1>) ]

rule SAT_1:
    let c_e    = aenc(~ss_e, pke)
        c_mc   = aenc(~ss_mc, pkMC)
        th     = h(<pke, c_e, c_mc>)
        k      = kdf(<psk, ~ss_e, ~ss_mc, th>)
        m2     = senc(<'pl2', c_e, c_mc>, psk)
    in
    [ !Ltk($SAT, ltkSAT)
    , !Pk($MC, pkMC)
    , !Psk($MC, $SAT, psk)
    , In(<'M1', senc(<'pl1', pke>, psk)>)
    , Fr(~ss_e)
    , Fr(~ss_mc)
    , Fr(~sidS) ]
  --[ Running(  $SAT, $MC, <'SATtoMC', k, th> )
    , RunningKey($SAT, $MC, k)
    , Honest($SAT), Honest($MC) ]->
    [ St_SAT_1($SAT, $MC, ~sidS, k, th, pke, c_e, c_mc)
    , Out(<'M2', m2>) ]

rule MC_2:
    let th     = h(<pke, c_e, c_mc>)
        ss_e   = adec(c_e, ~ske)
        ss_mc  = adec(c_mc, ltkMC)
        k      = kdf(<psk, ss_e, ss_mc, th>)
        conf_m = senc(<'mc', th>, k)
    in
    [ St_MC_1($MC, $SAT, ~sid, ltkMC, psk, ~ske, pke)
    , In(<'M2', senc(<'pl2', c_e, c_mc>, psk)>) ]
  --[ Running(  $MC, $SAT, <'MCtoSAT', k, th> )
    , Commit(   $MC, $SAT, <'MCtoSAT', k, th> )
    , CommitKey($MC, $SAT, k)
    , AcceptMC( $MC, $SAT, k)
    , Secret(k)
    , Honest($MC), Honest($SAT) ]->
    [ Out(<'M3', conf_m>)
    , !SessKey($MC, $SAT, k) ]

rule SAT_2:
    [ St_SAT_1($SAT, $MC, ~sidS, k, th, pke, c_e, c_mc)
    , In(<'M3', conf_m>) ]
  --[ Eq(conf_m, senc(<'mc', th>, k))
    , Commit(   $SAT, $MC, <'SATtoMC', k, th> )
    , AcceptSat($SAT, $MC, k)
    , Secret(k)
    , Honest($SAT), Honest($MC) ]->
    [ !SessKey($SAT, $MC, k) ]

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction OnlyOnce:
    "All A #i #j. OnlyOnce(A) @ #i & OnlyOnce(A) @ #j ==> #i = #j"

lemma executable:
    exists-trace
    "Ex MC SAT k #a #b.
        AcceptMC(MC, SAT, k) @ #a
      & AcceptSat(SAT, MC, k) @ #b"

lemma initiator_auth_holds:
    "All SAT MC k th #i.
        Commit(SAT, MC, <'SATtoMC', k, th>) @ #i
      ==>
        ( Ex #j. Running(MC, SAT, <'MCtoSAT', k, th>) @ #j & #j < #i )
      | ( Ex A #r. LtkReveal(A) @ #r & Honest(A) @ #i & #r < #i )"

lemma responder_auth_expected_fail:
    "All MC SAT k th #i.
        Commit(MC, SAT, <'MCtoSAT', k, th>) @ #i
      ==>
        ( Ex #j. Running(SAT, MC, <'SATtoMC', k, th>) @ #j & #j < #i )
      | ( Ex A #r. LtkReveal(A) @ #r & Honest(A) @ #i & #r < #i )"

lemma key_secrecy_psk_intact:
    "All k #i.
        Secret(k) @ #i & not (Ex M S #p. PskReveal(M, S) @ #p)
      ==>
        ( not (Ex #j. K(k) @ #j) )
      | ( Ex A #r. LtkReveal(A) @ #r & Honest(A) @ #i )"

lemma post_compromise_security_expected_fail:
    "All k #i.
        Secret(k) @ #i & (Ex MC SAT #p. PskReveal(MC, SAT) @ #p)
      ==>
        ( not (Ex #j. K(k) @ #j) )
      | ( Ex A #r. LtkReveal(A) @ #r & Honest(A) @ #i )"

end
