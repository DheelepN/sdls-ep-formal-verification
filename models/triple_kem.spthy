/*
  ============================================================================
  Triple-KEM key-update mechanism for SDLS  (Hulsing, Lange, Weber, CANS 2025)
  ============================================================================

  Symbolic (Dolev-Yao) model in Tamarin of the standalone KEM-based
  key-update/establishment protocol proposed as a CCSDS blue-book candidate.

  Roles:
    Initiator  = Mission Control (MC)
    Responder  = Satellite       (SAT)

  Long-term KEM keypairs for MC and SAT; ephemeral KEM keypair generated by MC.
  A pre-shared key (psk) authenticated-encrypts the flights (defence in depth);
  the psk MAY be compromised or absent, so security must rest on the KEMs.

  Messages (Fig. 1 of the paper, "with psk" case):
    M1  MC -> SAT :  AEAD_psk( c_sat , pk_e )
    M2  SAT-> MC  :  AEAD_psk( c_e , c_mc , confirm_sat )
    M3  MC -> SAT :  confirm_mc

  where
    c_sat = Encap(pk_sat)      -- challenges SAT's long-term key (authenticates SAT)
    c_e   = Encap(pk_e)        -- ephemeral encapsulation (forward secrecy)
    c_mc  = Encap(pk_mc)       -- challenges MC's long-term key (authenticates MC)
    th    = H(c_sat, pk_e, c_e, c_mc)                 -- handshake/transcript hash
    k     = KDF(psk, ss_sat, ss_e, ss_mc, th)         -- derived only after handshake

  KEM abstraction: an IND-CCA KEM is modelled as public-key encryption of a
  fresh shared secret. Encap(pk) := aenc(~ss, pk); Decap(sk,c) := adec(c,sk).

  Key confirmation is bidirectional (the paper "always insists on key
  confirmations"): SAT confirms in M2, MC confirms in M3.
  ============================================================================
*/

theory triple_kem
begin

builtins: asymmetric-encryption, symmetric-encryption, hashing

functions: kdf/1

/* --------------------------------------------------------------------------
   Setup / PKI
   -------------------------------------------------------------------------- */

// Long-term KEM keypair, one per agent, registered once.
rule Register_ltk:
    [ Fr(~ltk) ]
  --[ OnlyOnce($A) ]->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

// Pairwise pre-shared key between an MC and a SAT.
rule Register_psk:
    [ Fr(~psk) ]
  --[ PskInit($MC, $SAT) ]->
    [ !Psk($MC, $SAT, ~psk) ]

/* --------------------------------------------------------------------------
   Adversary capabilities
   -------------------------------------------------------------------------- */

// Compromise a long-term KEM secret key.
rule Reveal_ltk:
    [ !Ltk($A, ltk) ] --[ LtkReveal($A) ]-> [ Out(ltk) ]

// Compromise a pre-shared key (models the "no psk / all-zero psk" and the
// "prior key already leaked" situations that post-compromise security targets).
rule Reveal_psk:
    [ !Psk($MC, $SAT, psk) ] --[ PskReveal($MC, $SAT) ]-> [ Out(psk) ]

/* --------------------------------------------------------------------------
   Protocol
   -------------------------------------------------------------------------- */

// M1: MC initiates. Encapsulates to SAT's long-term key, ships ephemeral pk.
rule MC_1:
    let pke   = pk(~ske)
        c_sat = aenc(~ss_sat, pkSAT)
        m1    = senc(<'pl1', c_sat, pke>, psk)
    in
    [ !Ltk($MC, ltkMC)
    , !Pk($SAT, pkSAT)
    , !Psk($MC, $SAT, psk)
    , Fr(~ss_sat)
    , Fr(~ske)
    , Fr(~sid) ]
  --[ StartMC($MC, $SAT, ~sid) ]->
    [ St_MC_1($MC, $SAT, ~sid, ltkMC, psk, ~ss_sat, ~ske, c_sat, pke)
    , Out(<'M1', m1>) ]

// M2: SAT decapsulates the challenge to its long-term key, encapsulates to the
// ephemeral key and to MC's long-term key, derives k, confirms.
rule SAT_1:
    let ss_sat = adec(c_sat, ltkSAT)
        c_e    = aenc(~ss_e, pke)
        c_mc   = aenc(~ss_mc, pkMC)
        th     = h(<c_sat, pke, c_e, c_mc>)
        k      = kdf(<psk, ss_sat, ~ss_e, ~ss_mc, th>)
        conf_s = senc(<'sc', th>, k)
        m2     = senc(<'pl2', c_e, c_mc, conf_s>, psk)
    in
    [ !Ltk($SAT, ltkSAT)
    , !Pk($MC, pkMC)
    , !Psk($MC, $SAT, psk)
    , In(<'M1', senc(<'pl1', c_sat, pke>, psk)>)
    , Fr(~ss_e)
    , Fr(~ss_mc)
    , Fr(~sidS) ]
  --[ Running(  $SAT, $MC, <'SATtoMC', k, th> )
    , RunningKey($SAT, $MC, k)
    , Honest($SAT), Honest($MC) ]->
    [ St_SAT_1($SAT, $MC, ~sidS, k, th, c_sat, pke, c_e, c_mc)
    , Out(<'M2', m2>) ]

// M3: MC decapsulates both answers, derives k, checks SAT's confirmation,
// sends its own confirmation, and commits.
rule MC_2:
    let th     = h(<c_sat, pke, c_e, c_mc>)
        ss_e   = adec(c_e, ~ske)
        ss_mc  = adec(c_mc, ltkMC)
        k      = kdf(<psk, ~ss_sat, ss_e, ss_mc, th>)
        conf_m = senc(<'mc', th>, k)
    in
    [ St_MC_1($MC, $SAT, ~sid, ltkMC, psk, ~ss_sat, ~ske, c_sat, pke)
    , In(<'M2', senc(<'pl2', c_e, c_mc, conf_s>, psk)>) ]
  --[ Eq(conf_s, senc(<'sc', th>, k))
    , Running(  $MC, $SAT, <'MCtoSAT', k, th> )
    , Commit(   $MC, $SAT, <'MCtoSAT', k, th> )
    , CommitKey($MC, $SAT, k)
    , AcceptMC( $MC, $SAT, k)
    , Secret(k)
    , Honest($MC), Honest($SAT) ]->
    [ Out(<'M3', conf_m>)
    , !SessKey($MC, $SAT, k) ]

// SAT receives MC's confirmation and commits.
rule SAT_2:
    [ St_SAT_1($SAT, $MC, ~sidS, k, th, c_sat, pke, c_e, c_mc)
    , In(<'M3', conf_m>) ]
  --[ Eq(conf_m, senc(<'mc', th>, k))
    , Commit(   $SAT, $MC, <'SATtoMC', k, th> )
    , CommitKey($SAT, $MC, k)
    , AcceptSat($SAT, $MC, k)
    , Secret(k)
    , Honest($SAT), Honest($MC) ]->
    [ !SessKey($SAT, $MC, k) ]

/* --------------------------------------------------------------------------
   Restrictions
   -------------------------------------------------------------------------- */

restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction OnlyOnce:
    "All A #i #j. OnlyOnce(A) @ #i & OnlyOnce(A) @ #j ==> #i = #j"

/* --------------------------------------------------------------------------
   Sanity: the protocol can complete
   -------------------------------------------------------------------------- */

lemma executable:
    exists-trace
    "Ex MC SAT k #a #b.
        AcceptMC(MC, SAT, k) @ #a
      & AcceptSat(SAT, MC, k) @ #b"

/* --------------------------------------------------------------------------
   Key secrecy.
   The derived key stays secret unless a long-term key or the ephemeral was
   compromised. Compromise of the psk ALONE must NOT break the key: that is
   the asymmetric guarantee the proposal is built to provide.
   -------------------------------------------------------------------------- */

lemma key_secrecy:
    "All k #i.
        Secret(k) @ #i
      ==>
        ( not (Ex #j. K(k) @ #j) )
      | ( Ex A #r. LtkReveal(A) @ #r & Honest(A) @ #i )"

/* --------------------------------------------------------------------------
   Forward secrecy.
   If the key is learned by the adversary, then a long-term key of an honest
   party must have been revealed BEFORE the session committed. Revealing a
   long-term key later must not expose an earlier key.
   -------------------------------------------------------------------------- */

lemma forward_secrecy:
    "All k #i #j.
        Secret(k) @ #i & K(k) @ #j
      ==>
        ( Ex A #r. LtkReveal(A) @ #r & Honest(A) @ #i & #r < #i )"

/* --------------------------------------------------------------------------
   Post-compromise security (the headline claim), in the sense of psk
   compromise: even if the psk (a prior shared secret / prior session state)
   is revealed, the newly established key is secret, provided the long-term
   keys and the ephemeral of THIS run were not compromised.

   Note: key_secrecy above already lets the adversary reveal any psk, so this
   lemma is a special case of it (same conclusion, stronger hypothesis). It is
   stated separately only to make the psk-compromise scenario explicit; it is
   not an independent result. Healing after LONG-TERM key compromise is not
   modelled here.
   -------------------------------------------------------------------------- */

lemma post_compromise_security:
    "All k #i.
        Secret(k) @ #i & (Ex MC SAT #p. PskReveal(MC, SAT) @ #p)
      ==>
        ( not (Ex #j. K(k) @ #j) )
      | ( Ex A #r. LtkReveal(A) @ #r & Honest(A) @ #i )"

/* --------------------------------------------------------------------------
   Injective agreement (mutual authentication).
   When MC commits to (k, th) with SAT, SAT indeed ran with MC on the same
   (k, th), uniquely, unless a long-term key was revealed beforehand.
   -------------------------------------------------------------------------- */

lemma mutual_authentication_MC:
    "All MC SAT k th #i.
        Commit(MC, SAT, <'MCtoSAT', k, th>) @ #i
      ==>
        ( Ex #j. Running(SAT, MC, <'SATtoMC', k, th>) @ #j & #j < #i
          & not (Ex MC2 SAT2 #i2.
                 Commit(MC2, SAT2, <'MCtoSAT', k, th>) @ #i2 & not(#i2 = #i)) )
      | ( Ex A #r. LtkReveal(A) @ #r & Honest(A) @ #i & #r < #i )"

/* --------------------------------------------------------------------------
   Injective agreement, the other direction.
   When SAT commits to (k, th) with MC, MC indeed ran with SAT on the same
   (k, th), uniquely, unless a long-term key was revealed beforehand. MC is
   authenticated to SAT by c_mc: only the holder of MC's long-term key
   recovers ss_mc, which feeds k and hence MC's confirmation in M3.
   Together with mutual_authentication_MC this is mutual authentication.
   -------------------------------------------------------------------------- */

lemma mutual_authentication_SAT:
    "All SAT MC k th #i.
        Commit(SAT, MC, <'SATtoMC', k, th>) @ #i
      ==>
        ( Ex #j. Running(MC, SAT, <'MCtoSAT', k, th>) @ #j & #j < #i
          & not (Ex SAT2 MC2 #i2.
                 Commit(SAT2, MC2, <'SATtoMC', k, th>) @ #i2 & not(#i2 = #i)) )
      | ( Ex A #r. LtkReveal(A) @ #r & Honest(A) @ #i & #r < #i )"

/* --------------------------------------------------------------------------
   Key agreement: both endpoints that accept a key agree it is shared with the
   right peer, unless a long-term key was revealed.
   -------------------------------------------------------------------------- */

lemma key_agreement:
    "All MC SAT k #i.
        AcceptMC(MC, SAT, k) @ #i
      ==>
        ( Ex #j. RunningKey(SAT, MC, k) @ #j )
      | ( Ex A #r. LtkReveal(A) @ #r & Honest(A) @ #i & #r < #i )"

end
